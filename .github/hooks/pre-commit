#!/bin/sh
#
# Pre-commit hook to run Python linting checks before allowing the commit
# This hook detects the OS and runs the appropriate script (bash or PowerShell)

# Detect if we're running on Windows
case "$(uname -s)" in
    CYGWIN*|MINGW*|MSYS*)
        # Windows detected - run the PowerShell script if possible
        if command -v pwsh >/dev/null 2>&1; then
            pwsh -File "$(dirname "$0")/pre-commit.ps1"
            exit $?
        elif command -v powershell >/dev/null 2>&1; then
            powershell -File "$(dirname "$0")/pre-commit.ps1"
            exit $?
        else
            echo "Warning: Running on Windows but PowerShell not found. Falling back to bash version."
        fi
        ;;
esac

# Unix version (or Windows fallback)
echo "Running pre-commit checks..."

# Get the list of staged Python files
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.py$' || true)

if [ -z "$STAGED_PY_FILES" ]; then
  echo "No Python files to check, skipping linting."
  exit 0
fi

# Run the linter on the staged Python files
python .github/workflows/scripts/lint_python_files.py $STAGED_PY_FILES

# If lint_python_files.py returns a non-zero code, abort the commit
if [ $? -ne 0 ]; then
  echo "❌ Pre-commit check failed! Fix the linting issues before committing."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
exit 0 