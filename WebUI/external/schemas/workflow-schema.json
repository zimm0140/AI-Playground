{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComfyUI Workflow Schema",
  "description": "Schema for ComfyUI workflow JSON files in AI-Playground",
  "type": "object",
  "required": ["name", "backend", "comfyUIRequirements", "inputs", "outputs"],
  "properties": {
    "name": {
      "type": "string",
      "description": "The display name of the workflow"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the workflow (major.minor.patch)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "changeLog": {
      "type": "array",
      "description": "History of changes to the workflow",
      "items": {
        "type": "object",
        "required": ["version", "date", "changes"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "displayPriority": {
      "type": "integer",
      "description": "Priority in the display list, higher numbers shown first"
    },
    "backend": {
      "type": "string",
      "enum": ["comfyui"],
      "description": "Backend system used for running the workflow"
    },
    "comfyUIRequirements": {
      "type": "object",
      "description": "Requirements needed for the workflow to run",
      "properties": {
        "customNodes": {
          "type": "array",
          "description": "Custom ComfyUI nodes required by the workflow",
          "items": {
            "type": "string"
          }
        },
        "pythonPackages": {
          "type": "array",
          "description": "Python packages required for the workflow",
          "items": {
            "type": "string"
          }
        },
        "requiredModels": {
          "type": "array",
          "description": "AI models required by the workflow",
          "items": {
            "type": "object",
            "required": ["type", "model"],
            "properties": {
              "type": {
                "type": "string",
                "description": "Type of model (checkpoint, lora, unet, clip, vae, etc)"
              },
              "model": {
                "type": "string",
                "description": "Path or identifier for the model"
              },
              "version": {
                "type": "string",
                "description": "Version requirement for the model"
              },
              "fallbacks": {
                "type": "array",
                "description": "Alternative models that can be used",
                "items": {
                  "type": "string"
                }
              },
              "additionalLicenceLink": {
                "type": "string",
                "description": "Link to additional license information"
              }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "Tags for categorizing the workflow",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "description": "System requirements for the workflow",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the workflow"
    },
    "examples": {
      "type": "array",
      "description": "Example inputs and outputs for this workflow",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title for this example"
          },
          "description": {
            "type": "string",
            "description": "Description of this example"
          },
          "inputSettings": {
            "type": "object",
            "description": "Input settings used for this example"
          },
          "inputImage": {
            "type": "string",
            "description": "URL or data URI for example input image"
          },
          "outputImage": {
            "type": "string",
            "description": "URL or data URI for example output image"
          }
        },
        "required": ["title"]
      }
    },
    "resourceEstimation": {
      "type": "object",
      "description": "Estimated resource requirements for this workflow",
      "properties": {
        "vramMinimum": {
          "type": "integer",
          "description": "Minimum VRAM required in MB"
        },
        "vramRecommended": {
          "type": "integer",
          "description": "Recommended VRAM in MB"
        },
        "diskSpace": {
          "type": "integer",
          "description": "Disk space required in MB"
        },
        "cpuUsage": {
          "type": "string",
          "description": "CPU usage description",
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "components": {
      "type": "array",
      "description": "Reusable components used in this workflow",
      "items": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": "string",
            "description": "Unique identifier for the component"
          },
          "componentType": {
            "type": "string",
            "description": "Type of component"
          },
          "description": {
            "type": "string",
            "description": "Description of what this component does"
          },
          "nodeIds": {
            "type": "array",
            "description": "Node IDs that are part of this component",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["componentId", "componentType", "nodeIds"]
      }
    },
    "inputs": {
      "type": "array",
      "description": "User inputs for the workflow",
      "items": {
        "type": "object",
        "properties": {
          "nodeTitle": {
            "type": "string",
            "description": "Title of the node associated with this input"
          },
          "nodeInput": {
            "type": "string",
            "description": "Input parameter name of the node"
          },
          "type": {
            "type": "string",
            "description": "Data type of the input",
            "enum": ["string", "integer", "number", "boolean", "image", "array", "object"]
          },
          "label": {
            "type": "string",
            "description": "User-friendly label for the input"
          },
          "defaultValue": {
            "description": "Default value for the input"
          }
        },
        "required": ["type"]
      }
    },
    "outputs": {
      "type": "array",
      "description": "Outputs from the workflow",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the output"
          },
          "type": {
            "type": "string",
            "description": "Data type of the output",
            "enum": ["image", "video", "audio", "text"]
          }
        },
        "required": ["name", "type"]
      }
    },
    "defaultSettings": {
      "type": "object",
      "description": "Default settings for the workflow"
    },
    "displayedSettings": {
      "type": "array",
      "description": "Settings to display in the UI",
      "items": {
        "type": "string"
      }
    },
    "modifiableSettings": {
      "type": "array",
      "description": "Settings that the user can modify",
      "items": {
        "type": "string"
      }
    },
    "comfyUiApiWorkflow": {
      "type": "object",
      "description": "The actual ComfyUI workflow definition"
    }
  }
} 