{
  "$schema": "https://raw.githubusercontent.com/AI-Playground/main/WebUI/external/schemas/workflow-schema.json",
  "name": "Colorize",
  "version": "1.0.0",
  "changeLog": [
    {
      "version": "1.0.0",
      "date": "2024-03-08",
      "changes": ["Initial release"]
    }
  ],
  "displayPriority": 300,
  "backend": "comfyui",
  "description": "Colorize black and white or grayscale images using DDColor technology.",
  "comfyUIRequirements": {
    "customNodes": ["kijai/ComfyUI-DDColor@30d5b8e7666382a6a78404caee28dfa87f741037"],
    "requiredModels": []
  },
  "tags": ["colorization", "image-to-image"],
  "requirements": ["high-vram"],
  "resourceEstimation": {
    "vramMinimum": 6144,
    "vramRecommended": 8192,
    "diskSpace": 2000,
    "cpuUsage": "medium"
  },
  "inputs": [
    {
      "nodeTitle": "DDColor_Colorize",
      "nodeInput": "checkpoint",
      "type": "array",
      "label": "checkpoint model",
      "options": [
        "ddcolor_paper_tiny.pth",
        "ddcolor_paper.pth",
        "ddcolor_modelscope.pth",
        "ddcolor_artistic.pth"
      ],
      "defaultValue": ["ddcolor_artistic.pth"]
    },
    {
      "nodeTitle": "Load Image",
      "nodeInput": "image",
      "type": "image",
      "label": "Reference Image",
      "defaultValue": "data:image/png;base64,"
    }
  ],
  "outputs": [
    {
      "name": "output_image",
      "type": "image"
    }
  ]
}