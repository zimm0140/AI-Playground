FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy the hardware detection package
COPY hardware_detection/ /app/hardware_detection/
COPY pyproject.toml setup.py README.md uvfast.json /app/

# Copy the mock packages
COPY hardware_detection/tests/mocks/ /app/mocks/

# Install the package
RUN pip install --no-cache-dir -e .

# Install the Intel Arc mock package
RUN pip install --no-cache-dir -e /app/mocks/intel-gpu-stub

# Set environment variables
ENV SIMULATED_HARDWARE=acm
ENV UVFAST_MOCK_DIR=/app/.uvfast/mock

# Create mock files
RUN mkdir -p "$UVFAST_MOCK_DIR" \
    && echo "Intel(R) Arc(TM) A770 Graphics" > "$UVFAST_MOCK_DIR/gpu_info.txt" \
    && echo "vendor: Intel" > "$UVFAST_MOCK_DIR/cpu_info.txt" \
    && echo "name: Intel(R) Core(TM) i9-13900K" >> "$UVFAST_MOCK_DIR/cpu_info.txt" \
    && echo "cores: 24" >> "$UVFAST_MOCK_DIR/cpu_info.txt"

# Run the hardware detection CLI by default
ENTRYPOINT ["python", "-m", "hardware_detection.cli"]
CMD ["info"] 