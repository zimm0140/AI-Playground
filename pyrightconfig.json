{
  "include": [
    ".github/workflows/scripts/**",
    "tests/**"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "service/**",
    "LlamaCPP/**",
    "OpenVINO/**"
  ],
  "ignoreExternal": true,
  "extraPaths": [
    "service/lib",
    "LlamaCPP/lib"
  ],
  "stubPath": "typings",
  "venvPath": ".",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "pythonVersion": "3.9",
  "typeCheckingMode": "basic",
  "reportCallIssue": "none"
} 